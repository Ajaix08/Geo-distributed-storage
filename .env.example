# GeoDistributed File Storage Platform
# Copy this file to .env before running docker compose up --build

# Gateway / shared deployment values
MONGO_URI=mongodb://mongodb:27017/geo_storage
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
MAX_FILE_SIZE_MB=10
CORS_ORIGIN=http://localhost:5173
HEALTH_CHECK_INTERVAL_MS=10000
INDIA_SERVER_URL=http://india-server:5001
SINGAPORE_SERVER_URL=http://singapore-server:5002
GERMANY_SERVER_URL=http://germany-server:5003

# Frontend build-time variable
VITE_API_BASE_URL=http://localhost:5000/api

# Standalone development examples also exist at:
# gateway/.env.example
# services/india-server/.env.example
# services/singapore-server/.env.example
# services/germany-server/.env.example
# frontend/.env.example
